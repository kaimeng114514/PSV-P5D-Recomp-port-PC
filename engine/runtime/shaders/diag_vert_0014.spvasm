OpCapability Shader
%1 = OpExtInstImport "GLSL.std.450"
OpMemoryModel Logical GLSL450
OpEntryPoint Vertex %main "main" %pos %col %uv %glpos %o0 %o1
OpDecorate %glpos BuiltIn Position
OpDecorate %pos Location 0
OpDecorate %col Location 1
OpDecorate %uv Location 2
OpDecorate %o0 Location 0
OpDecorate %o1 Location 1
%void = OpTypeVoid
%f = OpTypeFloat 32
%v4 = OpTypeVector %f 4
%fn = OpTypeFunction %void
%pIn = OpTypePointer Input %v4
%pOut = OpTypePointer Output %v4
%f0 = OpConstant %f 0
%f1 = OpConstant %f 1
%f480 = OpConstant %f 480
%fm480 = OpConstant %f -480
%f272 = OpConstant %f 272
%pos = OpVariable %pIn Input
%col = OpVariable %pIn Input
%uv = OpVariable %pIn Input
%glpos = OpVariable %pOut Output
%o0 = OpVariable %pOut Output
%o1 = OpVariable %pOut Output
%main = OpFunction %void None %fn
%lbl = OpLabel
%p4 = OpLoad %v4 %pos
%c4 = OpLoad %v4 %col
%px = OpCompositeExtract %f %p4 0
%py = OpCompositeExtract %f %p4 1
%x0 = OpFSub %f %px %f480
%x1 = OpFDiv %f %x0 %f480
%y0 = OpFSub %f %py %f272
%y1 = OpFDiv %f %y0 %f272
%yn = OpFNegate %f %y1
%np = OpCompositeConstruct %v4 %x1 %yn %f0 %f1
OpStore %glpos %np
OpStore %o0 %c4
OpStore %o1 %c4
OpReturn
OpFunctionEnd
