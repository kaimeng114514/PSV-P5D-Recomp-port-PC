OpCapability Shader
%1 = OpExtInstImport "GLSL.std.450"
OpMemoryModel Logical GLSL450
OpEntryPoint Fragment %main "main" %out %in0 %in1
OpExecutionMode %main OriginUpperLeft
OpDecorate %out Location 0
OpDecorate %in0 Location 0
OpDecorate %in1 Location 1
OpDecorate %tex DescriptorSet 0
OpDecorate %tex Binding 2
%void = OpTypeVoid
%f = OpTypeFloat 32
%v2 = OpTypeVector %f 2
%v4 = OpTypeVector %f 4
%fn = OpTypeFunction %void
%pIn = OpTypePointer Input %v4
%pOut = OpTypePointer Output %v4
%img = OpTypeImage %f 2D 0 0 0 1 Unknown
%samp = OpTypeSampler
%simg = OpTypeSampledImage %img
%pimg = OpTypePointer UniformConstant %simg
%tex = OpVariable %pimg UniformConstant
%in0 = OpVariable %pIn Input
%in1 = OpVariable %pIn Input
%out = OpVariable %pOut Output
%f0 = OpConstant %f 0
%f1 = OpConstant %f 1
%f2 = OpConstant %f 2
%f3 = OpConstant %f 3
%main = OpFunction %void None %fn
%lbl = OpLabel
%c = OpLoad %v4 %in0
%u = OpLoad %v4 %in1
%ux = OpCompositeExtract %f %u 0
%uy = OpCompositeExtract %f %u 1
%uv2 = OpCompositeConstruct %v2 %ux %uy
%ld = OpLoad %simg %tex
%s = OpImageSampleImplicitLod %v4 %ld %uv2
%r = OpFMul %v4 %s %c
OpStore %out %r
OpReturn
OpFunctionEnd
